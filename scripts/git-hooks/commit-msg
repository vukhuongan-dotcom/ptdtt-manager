#!/bin/sh
# AG-R45-HOOK-DISPATCHER v1 (commit-msg)
set -eu

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CHAINED_HOOK="$HOOK_DIR/commit-msg.chained_pre_r45"
TMP_STDIN=$(umask 077; mktemp "${TMPDIR:-/tmp}/ag_r45_stdin.XXXXXX")
cleanup() {
    python3 -c 'import os,sys; p=sys.argv[1]; os.path.lexists(p) and os.unlink(p)' "$TMP_STDIN" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

if [ ! -t 0 ]; then
    cat > "$TMP_STDIN"
else
    : > "$TMP_STDIN"
fi

if [ -f "$CHAINED_HOOK" ] && [ -x "$CHAINED_HOOK" ]; then
    set +e
    "$CHAINED_HOOK" "$@" < "$TMP_STDIN"
    CHAIN_RC=$?
    set -e
    if [ "$CHAIN_RC" -ne 0 ]; then
        exit "$CHAIN_RC"
    fi
fi

ACTIVE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || (CDPATH= cd -- "$HOOK_DIR/../.." && pwd))
AG_GATE="${AG_REGISTRY_GATE_SCRIPT:-${AGENTS_ROOT:-$HOME/Projects/_agents}/scripts/project_registry_gate.py}"
if [ -f "$AG_GATE" ]; then
    exec python3 "$AG_GATE" verify --repo-root "$ACTIVE_ROOT" --staged-gate --commit-msg-file "$1"
fi
exec python3 "$ACTIVE_ROOT/scripts/register_bug_feat.py" --repo-root "$ACTIVE_ROOT" verify --staged-gate --commit-msg-file "$1"
