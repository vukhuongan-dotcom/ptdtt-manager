[Unit]
Description=PTDTT Manager Web App
After=network.target

[Service]
Type=simple
User=ptdtt
Group=www-data
WorkingDirectory=/var/www/ptdtt-manager
EnvironmentFile=/etc/default/ptdtt
ExecStart=/var/www/ptdtt-manager/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 1 \
    --threads 4 \
    --timeout 120 \
    --access-logfile /var/log/ptdtt/access.log \
    --error-logfile /var/log/ptdtt/error.log \
    server_flask:app
Restart=always
RestartSec=5

# Environment defaults (secrets loaded from /etc/default/ptdtt, chmod 600)
Environment="PORT=5000"

[Install]
WantedBy=multi-user.target

